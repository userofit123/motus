{
  "name": "Motus",
  "short_name": "Motus",
  "description": "Your self-hosted fitness tracker",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#17100d",
  "theme_color": "#17100d",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Start workout", "url": "/?start=1" },
    { "name": "Record a walk", "url": "/activities/record?type=walk" },
    { "name": "Log body weight", "url": "/body?add=1" }
  ]
}
