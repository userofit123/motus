<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect's client needs Android 8; the plugin checks the version and reports it missing below Android 9 -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- adjustResize: the page runs behind the system bars (MotusBarsPlugin), which then lifts it above the keyboard itself -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Health Connect asks for permissions only from an app that explains its use: this screen opens from its
             "privacy policy" link (Android 13 and older look for the action, 14 and newer for the alias below) -->
        <activity android:name=".HealthRationaleActivity" android:exported="true" android:label="Motus and Health Connect">
            <intent-filter><action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" /></intent-filter>
        </activity>
        <activity-alias android:name="ViewPermissionUsageActivity" android:exported="true"
            android:targetActivity=".HealthRationaleActivity" android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- the interval timer's changes while the app is in the background (MotusWorkoutPlugin.TimerCue) -->
        <receiver android:name=".MotusWorkoutPlugin$TimerCue" android:exported="false" />
        <!-- the rest's 10 seconds warning and 3-2-1 while the app is in the background (RestCues) -->
        <receiver android:name=".RestCues" android:exported="false" />
        <!-- puts the recording's notification back when it is swiped away (Android 13+ allows that for a foreground service's, Android 14+ for other ongoing ones) -->
        <receiver android:name=".MotusWorkoutPlugin$RecordingSwiped" android:exported="false" />

        <!-- keeps a walk's route and steps recording with the screen off; its notification is the recording's own (RecordingService) -->
        <service android:name=".RecordingService" android:exported="false" android:foregroundServiceType="location|health" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- whether the connection is metered, for updates' "Only on Wi-Fi" (granted without asking) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- rest timer and planned-workout notifications, on time even when the phone sleeps. Exact alarms: up to Android 12
         the one the user can take away; from 13 the one granted at install (an app's timer is what it is for), since
         Android 14 no longer grants the first by default and the rest-over alarm would then come minutes late -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- recording walks -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- the step counter while a walk is recorded -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <!-- reading what a band, scale or watch app wrote to Health Connect (MotusHealthPlugin); each is asked for on its own -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <!-- data older than 30 days before the first grant (Health Connect versions that offer it; asked for only there) -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <queries><package android:name="com.google.android.apps.healthdata" /></queries>
    <!-- installing updates downloaded from GitHub (sideloaded app; not for a Play Store build) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
