{
  "name": "motus-desktop",
  "productName": "Motus",
  "version": "0.1.0",
  "description": "Motus fitness tracker",
  "author": "Motus",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "@electric-sql/pglite": "0.2.15"
  },
  "devDependencies": {
    "@motus/server": "workspace:*",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "typescript": "5.7.2",
    "@motus/engine": "workspace:*"
  },
  "build": {
    "appId": "org.motus.app",
    "productName": "Motus",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../packages/exercise-data/images",
        "to": "images"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "userofit123",
      "repo": "motus"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness"
    }
  }
}
