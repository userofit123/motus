#!/bin/sh
# Nothing personal goes into a commit: the author must be a GitHub no-reply address,
# and files that hold data or secrets (backups, exports, .env, keystores) are refused.
email="$(git config user.email)"
case "$email" in
  *@users.noreply.github.com) ;;
  *) echo "pre-commit: author email must be a GitHub no-reply address (got: $email)"; exit 1 ;;
esac
bad="$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)\.env($|\.)|\.motusbackup$|\.mmbackup$|\.jks$|\.keystore$|\.p12$|(^|/)secrets/|^data/' | grep -v '\.env\.example$')"
if [ -n "$bad" ]; then
  echo "pre-commit: these files may hold data or secrets and cannot be committed:"; echo "$bad"; exit 1
fi
